# Copy to .env (never commit it) and replace every value marked as change-me.

# HTTP port of the monolith.
SERVER_PORT=8080

# PostgreSQL. docker compose builds DB_URL from DB_NAME; set DB_URL yourself when running with
# ./mvnw spring-boot:run, for example jdbc:postgresql://localhost:5432/shareway
DB_NAME=shareway
DB_USER=shareway
DB_PASSWORD=change-me

# HS256 secret shared with the API gateway and every extracted service (at least 32 bytes).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Service-to-service key, also sent to the internal endpoints of Payments & Settlement.
INTERNAL_API_KEY=change-me

# Base URLs of the extracted services. From the monolith container use the compose service name
# (for example http://driver-management:8081) or http://host.docker.internal:<port> for the host.
DRIVER_MANAGEMENT_URL=
# Required: Booking & Pricing asks it for every payment authorization.
PAYMENTS_SETTLEMENT_URL=http://host.docker.internal:8085
# X-Internal-Api-Key of Payments & Settlement; empty uses INTERNAL_API_KEY.
PAYMENTS_SETTLEMENT_API_KEY=
