# Copy to .env (never commit it) and replace every value marked as change-me.

# HTTP port of the monolith.
SERVER_PORT=8080

# PostgreSQL. docker compose builds DB_URL from DB_NAME; set DB_URL yourself when running with
# ./mvnw spring-boot:run, for example jdbc:postgresql://localhost:5432/shareway
DB_NAME=shareway
DB_USER=shareway
DB_PASSWORD=change-me

# HS256 secret shared with the API gateway and every extracted service (at least 32 bytes).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Key of the service-to-service endpoints under /api/v1/internal (Trip Execution uses it).
INTERNAL_API_KEY=change-me

# Optional administrator created on startup when both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
